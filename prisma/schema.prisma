generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
}

enum FieldType {
  TEXT
  DATE
  NUMBER
  PHONE
  EMAIL
  TEXTAREA
  CURRENCY
}

model User {
  id            String     @id @default(uuid())
  login         String     @unique
  passwordHash  String
  fullName      String
  role          Role       @default(MANAGER)
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  documents     Document[]

  @@map("users")
}

model Category {
  id        String     @id @default(uuid())
  name      String     @unique
  icon      String     @default("FileText")
  order     Int        @default(0)
  createdAt DateTime   @default(now())
  templates Template[]

  @@map("categories")
}

model Template {
  id           String              @id @default(uuid())
  name         String
  description  String?
  fileName     String
  filePath     String
  category     Category            @relation(fields: [categoryId], references: [id])
  categoryId   String
  isActive     Boolean             @default(true)
  usageCount   Int                 @default(0)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  placeholders TemplatePlaceholder[]
  documents    DocumentTemplate[]

  @@map("templates")
}

model TemplatePlaceholder {
  id         String    @id @default(uuid())
  template   Template  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateId String
  key        String    // {{ФИО}}, {{ИНН}} etc.
  label      String    // Human-readable name
  fieldType  FieldType @default(TEXT)
  required   Boolean   @default(true)
  order      Int       @default(0)
  isRepeatable Boolean @default(false) // for repeating blocks like invoice items
  groupName  String?   // group name for repeatable fields

  @@unique([templateId, key])
  @@map("template_placeholders")
}

model Document {
  id          String             @id @default(uuid())
  user        User               @relation(fields: [userId], references: [id])
  userId      String
  title       String
  fieldValues Json               // stored filled values
  createdAt   DateTime           @default(now())
  templates   DocumentTemplate[]

  @@map("documents")
}

model DocumentTemplate {
  id           String   @id @default(uuid())
  document     Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId   String
  template     Template @relation(fields: [templateId], references: [id])
  templateId   String
  generatedPath String? // path to generated PDF
  createdAt    DateTime @default(now())

  @@map("document_templates")
}
